{
  "family": "self-rag-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "4096",
  "containerDefinitions": [
    {
      "name": "self-rag",
      "image": "339954341771.dkr.ecr.us-east-1.amazonaws.com/self-rag:v1.0",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "FLASK_ENV",
          "value": "production"
        },
        {
          "name": "FLASK_HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "FLASK_PORT",
          "value": "5000"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "S3_DOCUMENTS_BUCKET",
          "value": "self-rag-documents-339954341771"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "MAX_UPLOAD_SIZE_MB",
          "value": "50"
        }
      ],
      "secrets": [
        {
          "name": "GROQ_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:339954341771:secret:self-rag/groq-api-key-5BY7rN"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/self-rag",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:5000/health || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      },
      "cpu": 0,
      "memoryReservation": 2048
    }
  ],
  "taskRoleArn": "arn:aws:iam::339954341771:role/self-rag-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::339954341771:role/self-rag-ecs-task-execution-role",
  "tags": [
    {
      "key": "Environment",
      "value": "Production"
    },
    {
      "key": "Application",
      "value": "Self-RAG"
    }
  ]
}